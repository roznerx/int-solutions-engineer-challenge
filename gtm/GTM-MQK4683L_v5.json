                "name": "cHTML - add_to_cart ecommerce push",
                "type": "html",
                "parameter": [
                    {
                        "type": "TEMPLATE",
                        "key": "html",
                        "value": "<script>\n  (function () {\n    var params = {{DLV - eventParams}};\n    var items = [];\n    var value = 0;\n\n    for (var i = 0; i < params.items.length; i++) {\n      var src = params.items[i];\n      var tax = Math.round(src.price * 0.21 * 100) / 100;\n      var item = {};\n\n      for (var key in src) {\n        item[key] = src[key];\n        if (key === 'price') item.tax = tax;\n      }\n\n      items.push(item);\n      value += (src.price + tax) * src.quantity;\n    }\n\n    window.dataLayer.push({ ecommerce: null });\n    window.dataLayer.push({\n      event: 'add_to_cart',\n      ecommerce: {\n        value: Math.round(value * 100) / 100,\n        currency: params.currency,\n        items: items\n      }\n    });\n  })();\n</script>"
